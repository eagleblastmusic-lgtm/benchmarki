{
  "manifest_version": 3,
  "name": "Bartosz Dev Bridge vNext",
  "version": "1.0.0",
  "description": "Target-only BDB vNext Browser transport with canonical admission recovery and no Browser lifecycle authority.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "transport_worker.js"
  },
  "action": {
    "default_title": "BDB vNext status",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content_adapter.js"
      ],
      "css": [
        "content_adapter.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
