  "must_see_ground_truth": [
    { "item_id": "S2-MS-01", "requirement": "M2a read_bytes/read_text are tied to the exact committed Git object database, not the mutable checkout filesystem.", "source_paths": ["bdb_vnext/repo_view.py"], "criticality": "HARD" },
    { "item_id": "S2-MS-02", "requirement": "A dirty worktree after view creation must not change bytes returned by that exact view; a newer commit is a different RepoView basis.", "source_paths": ["bdb_vnext/repo_view.py", "tests/test_vnext_engineering_intelligence.py"], "criticality": "HARD" },
    { "item_id": "S2-MS-03", "requirement": "repository_source_mismatch means the committed entry/object or accepted immutable bytes do not equal; it is not the expected signal for an ordinary dirty checkout.", "source_paths": ["bdb_vnext/engineering_intelligence.py", "bdb_vnext/content_store.py"], "criticality": "MATERIAL" },
    { "item_id": "S2-MS-04", "requirement": "The safe regression test must compare committed bytes and accepted raw bytes before/after a worktree edit and separately exercise fabricated or stale evidence.", "source_paths": ["tests/test_vnext_engineering_intelligence.py"], "criticality": "MATERIAL" }
  ],
  "known_constraints": ["read-only diagnosis", "never read mutable worktree bytes as authority", "same exact RepoView required for source validation", "no retry or repair side effects", "Legacy and runtime are out of scope"],
  "known_unknowns": ["The report does not identify whether the observed mismatch came from a newer RepoView, fabricated M2b bytes, or a wrong repository; the answer must keep those hypotheses separate."],
  "source_inference_distinctions": [
    { "distinction_id": "S2-SI-01", "statement": "Dirty checkout content is an observation about the worktree, not exact committed source authority." },
    { "distinction_id": "S2-SI-02", "statement": "An error code alone cannot prove which mismatch branch occurred without the bound view/object evidence." }
  ],
