{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bdb-vnext-candidate-thin-exact-base-authority-v1",
  "title": "BDB vNext thin exact Candidate base authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "repository_id", "repository_identity_digest", "object_format", "base_view_id", "commit_oid", "tree_oid", "candidate_id", "candidate_tree_digest", "changed_paths", "path_bindings"],
  "properties": {
    "schema": { "const": "bdb-vnext-candidate-thin-exact-base-authority-v1" },
    "kind": { "const": "THIN_EXACT_BASE_AUTHORITY_V1" },
    "repository_id": { "type": "string", "minLength": 1 },
    "repository_identity_digest": { "$ref": "#/$defs/digest" },
    "object_format": { "enum": ["sha1", "sha256"] },
    "base_view_id": { "$ref": "#/$defs/digest" },
    "commit_oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "tree_oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_tree_digest": { "$ref": "#/$defs/digest" },
    "changed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "path_bindings": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
