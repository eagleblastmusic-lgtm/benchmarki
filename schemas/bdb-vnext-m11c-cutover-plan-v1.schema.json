{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:schema:m11c-cutover-plan:v1",
  "title": "BDB Next M11c exact external cutover plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_id",
    "generation_id",
    "cutover_id",
    "authority_boundary",
    "authority_root",
    "runtime_root",
    "legacy_runtime_root",
    "preparation_id",
    "preparation_sha256",
    "slot_binding",
    "candidate_source_commit",
    "candidate_bundle_sha256",
    "source_head",
    "source_tree",
    "m9a_freeze_digest",
    "browser_bundle_digest",
    "native_manifest_digest",
    "tcb_witness_sha256",
    "operator_approval_required",
    "candidate_may_write_active_pointer",
    "production_activation_performed",
    "rollback_mode",
    "cutover_plan_sha256"
  ],
  "properties": {
    "schema": {"const": "bdb-vnext-m11c-cutover-plan-v1"},
    "runtime_id": {"const": "devmaster.bdb.vnext.runtime"},
    "generation_id": {"const": "bdb-vnext-g1"},
    "cutover_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,90}$"},
    "authority_boundary": {"const": "external_bootstrap_root"},
    "authority_root": {"type": "string", "minLength": 1},
    "runtime_root": {"type": "string", "minLength": 1},
    "legacy_runtime_root": {"type": "string", "minLength": 1},
    "preparation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "preparation_sha256": {"$ref": "#/$defs/digest"},
    "slot_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_state_sha256", "active_manifest_sha256", "previous_manifest_sha256", "candidate_manifest_sha256"],
      "properties": {
        "slot_state_sha256": {"$ref": "#/$defs/digest"},
        "active_manifest_sha256": {"$ref": "#/$defs/digest"},
        "previous_manifest_sha256": {"$ref": "#/$defs/digest"},
        "candidate_manifest_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "candidate_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_bundle_sha256": {"$ref": "#/$defs/digest"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "m9a_freeze_digest": {"$ref": "#/$defs/digest"},
    "browser_bundle_digest": {"$ref": "#/$defs/digest"},
    "native_manifest_digest": {"$ref": "#/$defs/digest"},
    "tcb_witness_sha256": {"$ref": "#/$defs/digest"},
    "operator_approval_required": {"const": true},
    "candidate_may_write_active_pointer": {"const": false},
    "production_activation_performed": {"const": false},
    "rollback_mode": {"const": "ROLL_FORWARD_ONLY"},
    "cutover_plan_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
