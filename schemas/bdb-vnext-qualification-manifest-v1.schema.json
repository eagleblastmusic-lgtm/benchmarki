{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bdb-vnext-qualification-manifest-v1.schema.json",
  "title": "BDB vNext Qualification Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "manifest_id",
    "source_head",
    "source_tree",
    "qualification_areas",
    "total_areas",
    "sha256_digest"
  ],
  "properties": {
    "schema": { "const": "bdb-vnext-qualification-manifest-v1" },
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string" },
    "source_head": { "type": "string" },
    "source_tree": { "type": "string" },
    "total_areas": { "type": "integer", "minimum": 20 },
    "qualification_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area_id",
          "name",
          "test_manifest",
          "required",
          "platform_prerequisite",
          "status"
        ],
        "properties": {
          "area_id": { "type": "string" },
          "name": { "type": "string" },
          "test_manifest": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required": { "type": "boolean" },
          "platform_prerequisite": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "NOT_RUN_BLOCKED", "FAIL"]
          },
          "evidence_destination": { "type": "string" },
          "blocker_reason": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "sha256_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
