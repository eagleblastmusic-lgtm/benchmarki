{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:schema:vnext-engineering-decision:v1",
  "title": "BDB vNext EngineeringDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "intent_basis", "repo_view_bases", "context_package_ids", "established_fact_claim_ids", "inference_claim_ids", "assumption_claim_ids", "hypothesis_claim_ids", "alternatives", "chosen_option_id", "must_preserve", "must_not", "expected_effect_scope", "acceptance_obligations", "evidence_obligations", "uncertainty", "requested_context_ids", "architecture_consequences", "revisit_triggers", "producer_id", "producer_version"],
  "properties": {
    "schema": { "const": "bdb-vnext-engineering-decision-v1" }, "decision_id": { "$ref": "#/$defs/sha256" }, "intent_basis": { "$ref": "#/$defs/intent" }, "repo_view_bases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repoView" } },
    "context_package_ids": { "$ref": "#/$defs/digests" }, "established_fact_claim_ids": { "$ref": "#/$defs/digests" }, "inference_claim_ids": { "$ref": "#/$defs/digests" }, "assumption_claim_ids": { "$ref": "#/$defs/digests" }, "hypothesis_claim_ids": { "$ref": "#/$defs/digests" },
    "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/option" } }, "chosen_option_id": { "$ref": "#/$defs/identifier" },
    "must_preserve": { "$ref": "#/$defs/texts" }, "must_not": { "$ref": "#/$defs/texts" }, "expected_effect_scope": { "$ref": "#/$defs/texts" }, "acceptance_obligations": { "$ref": "#/$defs/texts" }, "evidence_obligations": { "$ref": "#/$defs/texts" }, "uncertainty": { "$ref": "#/$defs/texts" }, "requested_context_ids": { "$ref": "#/$defs/digests" }, "architecture_consequences": { "$ref": "#/$defs/texts" }, "revisit_triggers": { "$ref": "#/$defs/texts" },
    "producer_id": { "$ref": "#/$defs/identifier" }, "producer_version": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256Oid": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]{0,127}$" }, "text": { "type": "string", "minLength": 1, "maxLength": 4096 }, "texts": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true }, "digests": { "type": "array", "items": { "$ref": "#/$defs/sha256" }, "uniqueItems": true },
    "intent": { "type": "object", "additionalProperties": false, "required": ["task_id", "intent_revision", "intent_digest"], "properties": { "task_id": { "$ref": "#/$defs/text" }, "intent_revision": { "$ref": "#/$defs/identifier" }, "intent_digest": { "$ref": "#/$defs/sha256" } } },
    "repoView": { "type": "object", "additionalProperties": false, "required": ["repository_id", "repository_identity_digest", "object_format", "commit_oid", "tree_oid", "view_id"], "properties": { "repository_id": { "$ref": "#/$defs/text" }, "repository_identity_digest": { "$ref": "#/$defs/sha256" }, "object_format": { "enum": ["sha1", "sha256"] }, "commit_oid": { "oneOf": [{ "$ref": "#/$defs/sha40" }, { "$ref": "#/$defs/sha256Oid" }] }, "tree_oid": { "oneOf": [{ "$ref": "#/$defs/sha40" }, { "$ref": "#/$defs/sha256Oid" }] }, "view_id": { "$ref": "#/$defs/sha256" } } },
    "option": { "type": "object", "additionalProperties": false, "required": ["schema", "option_id", "summary", "tradeoffs", "risks"], "properties": { "schema": { "const": "bdb-vnext-decision-option-v1" }, "option_id": { "$ref": "#/$defs/identifier" }, "summary": { "$ref": "#/$defs/text" }, "tradeoffs": { "$ref": "#/$defs/texts" }, "risks": { "$ref": "#/$defs/texts" } } }
  }
}
