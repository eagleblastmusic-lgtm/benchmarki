{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:schema:m11c-client-plan:v1",
  "title": "BDB Next M11c Browser Native client plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_id",
    "generation_id",
    "protocol_generation",
    "source_head",
    "source_tree",
    "browser_extension_id",
    "browser_install_mode",
    "browser_operator_action_required",
    "browser_bundle_root",
    "browser_bundle_digest",
    "native_host_name",
    "native_host_executable",
    "native_host_executable_sha256",
    "native_config_path",
    "native_config_sha256",
    "native_manifest_path",
    "native_manifest_sha256",
    "target_registry_key",
    "legacy_native_host_name",
    "legacy_registry_key",
    "production_activation_performed",
    "client_plan_sha256"
  ],
  "properties": {
    "schema": {"const": "bdb-vnext-m11c-client-plan-v1"},
    "runtime_id": {"const": "devmaster.bdb.vnext.runtime"},
    "generation_id": {"const": "bdb-vnext-g1"},
    "protocol_generation": {"const": "bdb-vnext-protocol-v1"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "browser_extension_id": {"const": "mopnolkjddkmgojfjkenjobehhmmklll"},
    "browser_install_mode": {"const": "OPERATOR_LOAD_UNPACKED"},
    "browser_operator_action_required": {"const": true},
    "browser_bundle_root": {"type": "string", "minLength": 1},
    "browser_bundle_digest": {"$ref": "#/$defs/digest"},
    "native_host_name": {"const": "com.bartosz.dev_bridge.vnext"},
    "native_host_executable": {"type": "string", "minLength": 1},
    "native_host_executable_sha256": {"$ref": "#/$defs/digest"},
    "native_config_path": {"type": "string", "minLength": 1},
    "native_config_sha256": {"$ref": "#/$defs/digest"},
    "native_manifest_path": {"type": "string", "minLength": 1},
    "native_manifest_sha256": {"$ref": "#/$defs/digest"},
    "target_registry_key": {"const": "HKCU\\Software\\Google\\Chrome\\NativeMessagingHosts\\com.bartosz.dev_bridge.vnext"},
    "legacy_native_host_name": {"const": "com.bartosz.dev_bridge"},
    "legacy_registry_key": {"const": "HKCU\\Software\\Google\\Chrome\\NativeMessagingHosts\\com.bartosz.dev_bridge"},
    "production_activation_performed": {"const": false},
    "client_plan_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
