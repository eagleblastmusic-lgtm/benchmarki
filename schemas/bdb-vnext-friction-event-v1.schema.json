{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bdb-vnext-friction-event-v1.schema.json",
  "title": "BDB vNext Friction Event v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "event_id",
    "fingerprint",
    "project_id",
    "category",
    "failure_class",
    "symptom",
    "severity",
    "provenance",
    "first_observed_at",
    "last_observed_at",
    "occurrence_count",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bdb-vnext-friction-event-v1"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\-\\.:]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "milestone_id": {
      "type": ["string", "null"]
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "binding_id": {
      "type": ["string", "null"]
    },
    "attempt_id": {
      "type": ["string", "null"]
    },
    "category": {
      "type": "string",
      "enum": [
        "ENVIRONMENT",
        "TOOLING",
        "INFRASTRUCTURE",
        "CODE_LOGIC",
        "WITNESS",
        "RECOVERY",
        "OPERATOR",
        "TIMEOUT",
        "CONFIGURATION",
        "PROCESS_EXECUTION"
      ]
    },
    "failure_class": {
      "type": "string",
      "minLength": 1
    },
    "symptom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "provenance": {
      "type": "string",
      "enum": ["MACHINE", "OPERATOR", "MANUAL_NOTE"]
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["OBSERVED", "TRIAGED", "PROMOTED", "RESOLVED", "SUPERSEDED"]
    },
    "root_cause": {
      "type": ["string", "null"]
    },
    "resolution": {
      "type": ["string", "null"]
    },
    "promoted_to_improvement_id": {
      "type": ["string", "null"]
    },
    "superseded_by_event_id": {
      "type": ["string", "null"]
    },
    "source_head": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "additionalProperties": false
}
