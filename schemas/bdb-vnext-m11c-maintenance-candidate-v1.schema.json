{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDB vNext post-ACTIVE maintenance candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maintenance_id", "candidate_bundle_sha256", "source_head", "source_tree", "candidate_manifest_sha256", "candidate_may_write_active_pointer", "production_activation_performed"],
  "properties": {
    "schema": {"const": "bdb-vnext-m11c-maintenance-candidate-v1"},
    "maintenance_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,90}$"},
    "candidate_bundle_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_may_write_active_pointer": {"const": false},
    "production_activation_performed": {"const": false}
  }
}
