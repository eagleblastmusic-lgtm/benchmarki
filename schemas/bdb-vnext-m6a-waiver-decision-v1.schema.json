{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bdb-vnext-m6a-waiver-decision-v1",
  "title": "BDB vNext M6a immutable waiver decision record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "waiver_id",
    "obligation_id",
    "subject_digest",
    "risk",
    "actor",
    "authority",
    "rationale",
    "scope",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "bdb-vnext-m6a-waiver-decision-v1"},
    "waiver_id": {"$ref": "#/$defs/digest"},
    "obligation_id": {"$ref": "#/$defs/digest"},
    "subject_digest": {"$ref": "#/$defs/digest"},
    "risk": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "authority": {"enum": ["USER", "ADMIN"]},
    "rationale": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
