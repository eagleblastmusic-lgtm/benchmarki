{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:schema:vnext-runtime-bundle:v1",
  "title": "BDB vNext exact runtime bundle descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_id",
    "bundle_id",
    "role",
    "source_commit",
    "supported_control_schema",
    "known_good",
    "health_entrypoint",
    "activation_policy"
  ],
  "properties": {
    "schema": {"const": "bdb-vnext-runtime-bundle-v1"},
    "runtime_id": {"const": "devmaster.bdb.vnext.runtime"},
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "role": {"enum": ["candidate", "recovery"]},
    "source_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "supported_control_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "max": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "known_good": {"type": "boolean"},
    "health_entrypoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "activation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_may_write_final_pointer"],
      "properties": {
        "candidate_may_write_final_pointer": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"role": {"const": "recovery"}},
        "required": ["role"]
      },
      "then": {
        "properties": {"known_good": {"const": true}}
      }
    }
  ]
}
