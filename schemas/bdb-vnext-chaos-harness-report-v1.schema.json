{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bdb-vnext-chaos-harness-report-v1.schema.json",
  "title": "BDB vNext Chaos Harness Report v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "report_id",
    "source_head",
    "source_tree",
    "total_scenarios",
    "passed_scenarios",
    "failed_scenarios",
    "reproducibility_percent",
    "executed_faults",
    "sha256_digest"
  ],
  "properties": {
    "schema": { "const": "bdb-vnext-chaos-harness-report-v1" },
    "schema_version": { "const": "1.0.0" },
    "report_id": { "type": "string" },
    "source_head": { "type": "string" },
    "source_tree": { "type": "string" },
    "total_scenarios": { "type": "integer", "minimum": 1 },
    "passed_scenarios": { "type": "integer", "minimum": 0 },
    "failed_scenarios": { "type": "integer", "minimum": 0 },
    "reproducibility_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "executed_faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fault_id",
          "fault_class",
          "seed",
          "subsystem_boundary",
          "injection_point",
          "expected_disposition",
          "actual_disposition",
          "is_reproducible"
        ],
        "properties": {
          "fault_id": { "type": "string" },
          "fault_class": { "type": "string" },
          "seed": { "type": "integer" },
          "subsystem_boundary": { "type": "string" },
          "injection_point": { "type": "string" },
          "expected_disposition": { "type": "string" },
          "actual_disposition": { "type": "string" },
          "is_reproducible": { "type": "boolean" },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "sha256_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
